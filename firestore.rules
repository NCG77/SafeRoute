rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(data) {
      return signedIn()
        && data.participantIds is list
        && request.auth.uid in data.participantIds;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /reports/{reportId} {
      allow create: if signedIn();
      allow read: if signedIn();
      allow update, delete: if false;
    }

    match /road_segments/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /safety_scores/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /routes/{id} {
      allow read: if isParticipant(resource.data);
      allow write: if false;

      match /live/current {
        allow read: if isParticipant(resource.data);
        allow update: if signedIn()
          && get(/databases/$(database)/documents/routes/$(id)).data.ownerId == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.participantIds == resource.data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['location', 'recordedAtMs', 'source', 'updatedAt']);
        allow create, delete: if false;
      }

      match /events/{eventId} {
        allow read: if signedIn()
          && isParticipant(
            get(/databases/$(database)/documents/routes/$(id)).data
          );
        allow write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /emergencies/{id} {
      allow read: if isParticipant(resource.data);
      allow write: if false;

      match /live/current {
        allow read: if isParticipant(resource.data);
        allow update: if signedIn()
          && get(/databases/$(database)/documents/emergencies/$(id)).data.ownerId == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.participantIds == resource.data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['location', 'recordedAtMs', 'source', 'updatedAt']);
        allow create, delete: if false;
      }

      match /events/{eventId} {
        allow read: if signedIn()
          && isParticipant(
            get(/databases/$(database)/documents/emergencies/$(id)).data
          );
        allow write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /guardians/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.guardianUserId == request.auth.uid);
      allow write: if false;
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /trust_logs/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /crowd_cells/{id} {
      allow read, write: if false;
    }
  }
}
